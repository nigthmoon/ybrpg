# ===== 部署配置模板 =====
# 用法：把本文件复制一份、重命名为 ".env"，按下面注释填写即可（.env 已被 gitignore，不会提交）
# 改完需要重启服务生效。

# 数据库文件路径（重要：放到项目外的专属目录，和本地/其它环境隔离，避免被部署覆盖）
#   Linux 示例：/home/你的用户名/ybrpg-data/app.db
#   Windows 示例：D:\ybrpg-prod\app.db
# 不填则默认用项目内 data/app.db
DB_PATH=./data/app.db

# JWT 签名密钥（改成一串足够长的随机字符串，不要用默认值）
JWT_SECRET=please-change-me-to-a-long-random-string

# 服务端口（默认 4000）
PORT=4000
